# Образ для сервера (AWS и т.п.): база и смысловой индекс скачиваются из GitHub Release db-v1,
# в git их нет. Если файлов индекса emb_*.npy в релизе нет, сайт работает без смыслового поиска.
FROM python:3.12-slim
WORKDIR /app
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt
ARG REL=https://github.com/tyunta-21/qonunchi/releases/download/db-v1
COPY fetch_data.py .
RUN python fetch_data.py "$REL" data
COPY app app
COPY build_db.py .
# модель смыслового поиска (~120 МБ) скачиваем при сборке, чтобы первый вопрос не ждал
ENV EMB_CACHE=/app/.emb_cache
RUN python -c "from app import semantic; semantic.model(); print('модель готова')" || echo "модель не скачалась: смысловой поиск будет выключен"
ENV PORT=10000
CMD ["sh", "-c", "uvicorn app.main:app --host 0.0.0.0 --port ${PORT} --proxy-headers --forwarded-allow-ips='*'"]
