# Что НЕ загружать в Google Cloud (без этого файла gcloud берёт .gitignore и не загрузит базу)
# Ключи никогда не попадают в образ: на хостинге они задаются как секреты
.env
.env.*
!.env.example
.venv/
**/__pycache__/
.git/
eval/runs/
eval/compare/
screenshots/
*.zip
data/api.db
data/*.db-*
data/*.tmp
