# Скопируйте этот файл в .env и впишите ключ. Файл .env никому не отправляйте.

# Какой ИИ использовать: claude, openai (ChatGPT) или mock (тест без ключа).
AI_PROVIDER=claude

# Ключ Claude: https://platform.claude.com (раздел API keys)
ANTHROPIC_API_KEY=
# Модель: claude-haiku-5-5 — самая дешёвая ($0.10 / $0.50 за 1 млн токенов).
# Если ответы слабые, попробуйте claude-sonnet-5-5 (в 20 раз дороже, но умнее).
CLAUDE_MODEL=claude-haiku-5-5

# Если хотите ChatGPT: AI_PROVIDER=openai и ключ с https://platform.openai.com/api-keys
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4.1-mini

# Сколько вопросов в час можно задать с одного адреса (защита от расхода денег)
CHAT_LIMIT_PER_HOUR=30

# RAG API (/v1) для тестировщиков: ключи доступа через запятую. Придумайте длинный случайный ключ.
RAG_API_KEYS=
